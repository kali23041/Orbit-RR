<% content_for :title, "Orbit — Book live skill sessions" %>

<section class="relative -mx-5 mb-20 overflow-hidden px-5 pb-16 pt-6 sm:pt-10">
  <div class="pointer-events-none absolute inset-0 -z-10 bg-[radial-gradient(ellipse_at_top,_rgba(15,118,110,0.18),_transparent_55%)]"></div>

  <div class="animate-fade-up max-w-3xl">
    <p class="font-display text-5xl font-extrabold tracking-tight text-ink sm:text-7xl">Orbit</p>
    <h1 class="mt-6 max-w-2xl font-display text-3xl font-semibold leading-[1.15] tracking-tight text-ink sm:text-5xl">
      Book a focused session with someone who already ships.
    </h1>
    <p class="mt-5 max-w-xl text-lg leading-relaxed text-muted">
      Mentorship that respects your calendar — 45-minute skill sessions with working engineers.
    </p>
    <div class="mt-8 flex flex-wrap gap-3">
      <%= link_to "Browse mentors", mentors_path, class: "btn-primary" %>
      <%= link_to "Become a mentor", new_mentor_profile_path, class: "btn-secondary" %>
    </div>
  </div>
</section>

<section class="animate-fade-up-delay border-t border-line pt-12">
  <div class="mb-8 flex items-end justify-between gap-4">
    <div>
      <h2 class="font-display text-2xl font-semibold text-ink sm:text-3xl">Featured mentors</h2>
      <p class="mt-1 text-sm text-muted">Open slots ready to book.</p>
    </div>
    <%= link_to "View all", mentors_path, class: "text-sm font-semibold text-accent hover:underline" %>
  </div>

  <div class="border-b border-line">
    <% @mentors.each do |mentor| %>
      <%= link_to mentor_path(mentor), class: "mentor-row group grid gap-2 sm:grid-cols-[1fr_auto] sm:items-center" do %>
        <div>
          <p class="font-display text-lg font-semibold text-ink group-hover:text-accent"><%= mentor.user.display_name %></p>
          <p class="mt-0.5 text-sm text-muted"><%= mentor.headline %></p>
        </div>
        <p class="text-sm font-semibold text-accent"><%= format_money(mentor.hourly_rate_cents, mentor.currency) %><span class="font-normal text-muted"> / session</span></p>
      <% end %>
    <% end %>
  </div>
</section>

<section class="mt-16 animate-rise">
  <h2 class="font-display text-xl font-semibold text-ink">Built as one Rails app</h2>
  <p class="mt-2 max-w-2xl text-sm leading-relaxed text-muted">
    Bookings and payments live in Rails. Firebase Auth + Firestore power live session rooms — a clean split you can demo and defend in interviews.
  </p>
  <ul class="mt-6 grid gap-3 text-sm text-muted sm:grid-cols-3">
    <li class="surface px-4 py-3">Firebase Auth → Rails session</li>
    <li class="surface px-4 py-3">Firestore chat · presence · typing</li>
    <li class="surface px-4 py-3">Stripe Checkout when configured</li>
  </ul>
</section>

<% if Rails.env.development? && !signed_in? && User.any? %>
  <section class="mt-14 border border-dashed border-line bg-surface/60 px-4 py-4">
    <p class="text-xs font-semibold uppercase tracking-[0.14em] text-muted">Dev login</p>
    <div class="mt-3 flex flex-wrap gap-2">
      <% User.limit(5).each do |user| %>
        <%= button_to "As #{user.display_name}", dev_login_path(user), method: :post, class: "chip hover:border-ink" %>
      <% end %>
    </div>
  </section>
<% end %>
