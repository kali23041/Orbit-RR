<% content_for :title, "Orbit — Book live skill sessions" %>
<% content_for :meta_description, "Book short 1:1 skill sessions. Made by Kartik Sabale." %>

<section class="relative -mx-5 mb-16 overflow-hidden px-5 pb-14 pt-6 sm:mb-20 sm:pb-20 sm:pt-12">
  <div class="pointer-events-none absolute inset-0 -z-10 bg-[radial-gradient(ellipse_at_top,_rgba(15,118,110,0.18),_transparent_55%)]"></div>

  <div class="animate-fade-up max-w-3xl">
    <p class="font-display text-5xl font-extrabold tracking-tight text-ink sm:text-7xl">Orbit</p>
    <h1 class="mt-6 max-w-2xl font-display text-3xl font-semibold leading-[1.12] tracking-tight text-ink sm:text-5xl">
      Book a focused session with someone who already ships.
    </h1>
    <p class="mt-5 max-w-xl text-lg leading-relaxed text-muted">
      Mentorship that respects your calendar — short skill sessions with working engineers.
    </p>
    <div class="mt-8 flex flex-wrap gap-3">
      <%= link_to "Browse mentors", mentors_path, class: "btn-primary" %>
      <%= link_to "Become a mentor", new_mentor_profile_path, class: "btn-secondary" %>
    </div>
  </div>
</section>

<section class="animate-fade-up-delay border-t border-line pt-12">
  <h2 class="page-title">How it works</h2>
  <p class="page-subtitle max-w-xl">Three steps from discovery to a live room.</p>
  <ol class="mt-8 grid gap-4 sm:grid-cols-3">
    <li class="surface p-5">
      <p class="text-xs font-semibold uppercase tracking-[0.14em] text-accent">01</p>
      <p class="mt-3 font-display text-lg font-semibold text-ink">Find a mentor</p>
      <p class="mt-2 text-sm leading-relaxed text-muted">Filter by skill, rate, or keyword and open their next available slots.</p>
    </li>
    <li class="surface p-5">
      <p class="text-xs font-semibold uppercase tracking-[0.14em] text-accent">02</p>
      <p class="mt-3 font-display text-lg font-semibold text-ink">Book a session</p>
      <p class="mt-2 text-sm leading-relaxed text-muted">Reserve the slot instantly. Add it to your calendar with one click.</p>
    </li>
    <li class="surface p-5">
      <p class="text-xs font-semibold uppercase tracking-[0.14em] text-accent">03</p>
      <p class="mt-3 font-display text-lg font-semibold text-ink">Meet in the room</p>
      <p class="mt-2 text-sm leading-relaxed text-muted">Join the live room for chat, presence, notes, and your video link.</p>
    </li>
  </ol>
</section>

<section class="mt-16 animate-rise">
  <div class="mb-8 flex items-end justify-between gap-4">
    <div>
      <h2 class="page-title">Featured mentors</h2>
      <p class="page-subtitle">Open slots ready to book.</p>
    </div>
    <%= link_to "View all", mentors_path, class: "text-sm font-semibold text-accent hover:underline" %>
  </div>

  <% if @mentors.any? %>
    <div class="border-b border-line">
      <% @mentors.each do |mentor| %>
        <%= link_to mentor_path(mentor), class: "mentor-row group grid gap-3 sm:grid-cols-[auto_1fr_auto] sm:items-center" do %>
          <%= avatar_chip_for(mentor.user, size_class: "avatar-chip h-10 w-10 text-sm") %>
          <div>
            <p class="font-display text-lg font-semibold text-ink group-hover:text-accent"><%= mentor.user.display_name %></p>
            <p class="mt-0.5 text-sm text-muted"><%= mentor.headline %></p>
          </div>
          <p class="text-sm font-semibold text-accent"><%= format_money(mentor.hourly_rate_cents, mentor.currency) %><span class="font-normal text-muted"> / session</span></p>
        <% end %>
      <% end %>
    </div>
  <% else %>
    <div class="empty-state">
      <p class="font-display text-xl font-semibold text-ink">No mentors listed yet</p>
      <p class="mt-2 text-sm text-muted">Check back soon or create the first mentor profile.</p>
      <%= link_to "Become a mentor", new_mentor_profile_path, class: "btn-primary mt-5" %>
    </div>
  <% end %>
</section>

<section class="mt-16 surface overflow-hidden p-6 sm:p-8">
  <div class="grid gap-6 sm:grid-cols-[1fr_auto] sm:items-center">
    <div>
      <p class="text-xs font-semibold uppercase tracking-[0.14em] text-accent">About</p>
      <h2 class="mt-3 font-display text-2xl font-semibold text-ink sm:text-3xl">I built Orbit</h2>
      <p class="mt-3 max-w-xl text-sm leading-relaxed text-muted">
        More projects and notes on my site.
      </p>
    </div>
    <div class="flex flex-col gap-3 sm:items-end">
      <%= link_to "kartiksabale.com", ApplicationHelper::PORTFOLIO_URL, target: "_blank", rel: "noopener noreferrer", class: "btn-primary" %>
    </div>
  </div>
</section>

<% if Rails.env.local? && !signed_in? && User.any? %>
  <section class="mt-10 rounded-md border border-dashed border-line/80 bg-white/40 px-3 py-3">
    <p class="text-[11px] font-semibold uppercase tracking-[0.14em] text-muted/80">Local only · Dev login</p>
    <div class="mt-2 flex flex-wrap gap-1.5">
      <% User.limit(5).each do |user| %>
        <%= button_to "As #{user.display_name}", dev_login_path(user), method: :post, class: "chip text-[11px] hover:border-ink" %>
      <% end %>
    </div>
  </section>
<% end %>
