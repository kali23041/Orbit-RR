<% content_for :title, "Dashboard — Orbit" %>

<div class="flex flex-wrap items-end justify-between gap-3">
  <div>
    <h1 class="page-title">Hey, <%= current_user.display_name %></h1>
    <p class="page-subtitle">Bookings, favorites, and notifications.</p>
  </div>
  <%= link_to notifications_path, class: "btn-secondary" do %>
    Notifications<% if @unread_notifications.to_i > 0 %> (<%= @unread_notifications %>)<% end %>
  <% end %>
</div>

<section class="mt-10">
  <h2 class="font-display text-2xl font-semibold text-ink">Your sessions</h2>
  <% if @learner_bookings.any? %>
    <ul class="mt-4 divide-y divide-[var(--color-line)] border-y border-line">
      <% @learner_bookings.each do |booking| %>
        <li class="flex flex-col gap-3 py-4 sm:flex-row sm:items-center sm:justify-between">
          <div class="flex items-start gap-3">
            <%= avatar_chip_for(booking.mentor_user) %>
            <div>
              <p class="font-display text-lg font-semibold text-ink"><%= booking.mentor_user.display_name %></p>
              <p class="text-sm text-muted"><%= l(booking.starts_at, format: :long) %></p>
              <div class="mt-2"><%= booking_status_badge(booking.status) %></div>
            </div>
          </div>
          <div class="flex flex-wrap gap-2">
            <%= link_to "Details", booking_path(booking), class: "btn-secondary py-2" %>
            <%= link_to "Live room", booking_room_path(booking), class: "btn-primary py-2" %>
            <%= link_to "ICS", ics_booking_path(booking), class: "btn-secondary py-2" %>
          </div>
        </li>
      <% end %>
    </ul>
  <% else %>
    <div class="empty-state mt-4">
      <p class="font-display text-lg font-semibold text-ink">No bookings yet</p>
      <p class="mt-2 text-sm text-muted">Find a mentor and reserve your first slot.</p>
      <%= link_to "Browse mentors", mentors_path, class: "btn-primary mt-5" %>
    </div>
  <% end %>
</section>

<% if @favorites.any? %>
  <section class="mt-10">
    <h2 class="font-display text-2xl font-semibold text-ink">Favorites</h2>
    <ul class="mt-4 space-y-2">
      <% @favorites.each do |mentor| %>
        <li class="flex items-center justify-between border-b border-line py-3">
          <div class="flex items-center gap-3">
            <%= avatar_chip_for(mentor.user) %>
            <div>
              <p class="font-medium text-ink"><%= mentor.user.display_name %></p>
              <p class="text-sm text-muted"><%= mentor.headline %></p>
            </div>
          </div>
          <%= link_to "Open", mentor_path(mentor), class: "text-sm font-semibold text-accent hover:underline" %>
        </li>
      <% end %>
    </ul>
  </section>
<% end %>

<% unless @mentor_profile %>
  <section class="mt-10 border border-dashed border-line bg-surface/70 p-5">
    <h2 class="font-display text-xl font-semibold text-ink">Teach on Orbit</h2>
    <p class="mt-1 text-sm text-muted">Publish a mentor profile and open availability slots.</p>
    <%= link_to "Create mentor profile", new_mentor_profile_path, class: "btn-ink mt-4" %>
  </section>
<% end %>
