<% content_for :title, "Mentor profile — Orbit" %>

<h1 class="page-title">
  <%= @mentor_profile.persisted? ? "Edit mentor profile" : "Become a mentor" %>
</h1>
<p class="page-subtitle">Publish your expertise, set a rate, and open slots for learners.</p>

<%= form_with model: @mentor_profile, url: mentor_profile_path, method: (@mentor_profile.persisted? ? :patch : :post), class: "mt-8 max-w-xl space-y-5" do |f| %>
  <% if @mentor_profile.errors.any? %>
    <div class="flash-banner flash-banner-alert">
      <%= @mentor_profile.errors.full_messages.to_sentence %>
    </div>
  <% end %>

  <div>
    <%= f.label :headline, class: "block text-sm font-medium text-ink" %>
    <%= f.text_field :headline, class: "field", placeholder: "Staff engineer coaching system design" %>
  </div>

  <div>
    <%= f.label :bio, class: "block text-sm font-medium text-ink" %>
    <%= f.text_area :bio, rows: 5, class: "field" %>
  </div>

  <div class="grid grid-cols-2 gap-4">
    <div>
      <%= f.label :hourly_rate_cents, "Rate (cents)", class: "block text-sm font-medium text-ink" %>
      <%= f.number_field :hourly_rate_cents, class: "field" %>
    </div>
    <div>
      <%= f.label :years_experience, class: "block text-sm font-medium text-ink" %>
      <%= f.number_field :years_experience, class: "field" %>
    </div>
  </div>

  <div>
    <p class="text-sm font-medium text-ink">Skills</p>
    <div class="mt-2 flex flex-wrap gap-3">
      <% @skills.each do |skill| %>
        <label class="inline-flex items-center gap-2 text-sm text-muted">
          <%= check_box_tag "mentor_profile[skill_ids][]", skill.id, @mentor_profile.skill_ids.include?(skill.id), class: "accent-[var(--color-accent)]" %>
          <%= skill.name %>
        </label>
      <% end %>
    </div>
  </div>

  <div class="flex items-center gap-2 text-sm text-ink">
    <%= f.check_box :active, class: "accent-[var(--color-accent)]" %>
    <%= f.label :active, "Listed publicly" %>
  </div>

  <%= f.submit class: "btn-primary cursor-pointer" %>
<% end %>
