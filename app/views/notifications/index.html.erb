<% content_for :title, "Notifications — Orbit" %>

<div class="mb-6 flex items-center justify-between gap-3">
  <h1 class="font-display text-3xl font-semibold text-ink">Notifications</h1>
  <%= button_to "Mark all read", read_all_notifications_path, method: :post, class: "btn-secondary py-2" %>
</div>

<% if @notifications.any? %>
  <ul class="divide-y divide-[var(--color-line)] border-y border-line">
    <% @notifications.each do |notification| %>
      <li class="py-4 <%= 'opacity-60' if notification.read? %>">
        <p class="font-medium text-ink"><%= notification.title %></p>
        <p class="mt-1 text-sm text-muted"><%= notification.body %></p>
        <div class="mt-2 flex gap-3 text-sm">
          <% unless notification.read? %>
            <%= button_to "Open", read_notification_path(notification), method: :post, class: "font-semibold text-accent hover:underline" %>
          <% else %>
            <%= link_to "Open", notification.link_path.presence || notifications_path, class: "font-semibold text-accent hover:underline" %>
          <% end %>
          <span class="text-muted"><%= time_ago_in_words(notification.created_at) %> ago</span>
        </div>
      </li>
    <% end %>
  </ul>
<% else %>
  <p class="text-sm text-muted">You’re all caught up.</p>
<% end %>
