<% content_for :title, "Live room — Orbit" %>

<div class="grid gap-6 lg:grid-cols-[0.9fr_1.1fr]">
  <section class="border border-slate-900/10 bg-white/70 p-5">
    <p class="text-sm uppercase tracking-[0.16em] text-[#1f6b4a]">Session room</p>
    <h1 class="mt-2 text-3xl" style="font-family: Fraunces, serif;">Chat + presence</h1>
    <p class="mt-3 text-sm text-slate-600">
      Mentored by <%= @booking.mentor_user.display_name %> · Learner <%= @booking.learner.display_name %>
    </p>
    <p class="mt-2 text-sm text-slate-600"><%= l(@booking.starts_at, format: :long) %></p>
    <p class="mt-4 text-sm"><%= booking_status_badge(@booking.status) %></p>
    <%= link_to "Open video call", @booking.meet_url, target: "_blank", rel: "noopener", class: "mt-6 inline-block rounded-sm border border-slate-900/15 px-4 py-2 text-sm font-semibold" %>
    <p class="mt-6 text-xs text-slate-500">Firebase path: <code><%= @booking.firebase_chat_path %></code></p>
  </section>

  <section class="border border-slate-900/10 bg-[#123528] p-5 text-[#e7f2ec]"
           data-controller="session-chat"
           data-session-chat-path-value="<%= @booking.firebase_chat_path %>"
           data-session-chat-user-value="<%= current_user.display_name %>"
           data-session-chat-config-value="<%= @firebase_config.to_json %>"
           data-session-chat-configured-value="<%= firebase_configured? %>">
    <div class="flex items-center justify-between">
      <h2 class="text-xl" style="font-family: Fraunces, serif;">Realtime chat</h2>
      <span data-session-chat-target="presence" class="text-xs text-[#9dceb8]">connecting…</span>
    </div>

    <div data-session-chat-target="messages" class="mt-4 h-80 space-y-2 overflow-y-auto rounded-sm border border-white/10 bg-black/20 p-3 text-sm"></div>

    <form data-action="session-chat#send" class="mt-4 flex gap-2">
      <input data-session-chat-target="input"
             type="text"
             placeholder="Write a message…"
             class="flex-1 rounded-sm border border-white/15 bg-white/10 px-3 py-2 text-sm text-white placeholder:text-white/50"
             autocomplete="off">
      <button type="submit" class="rounded-sm bg-[#2f9b6a] px-4 py-2 text-sm font-semibold text-white">Send</button>
    </form>
    <p data-session-chat-target="status" class="mt-2 text-xs text-[#f3c6b5]"></p>
  </section>
</div>
