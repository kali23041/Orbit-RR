<% content_for :title, "Live room — Orbit" %>

<div class="grid gap-6 lg:grid-cols-[0.85fr_1.15fr]">
  <div class="space-y-6">
    <section class="surface p-5 sm:p-6">
      <p class="text-xs font-semibold uppercase tracking-[0.16em] text-accent">Session room</p>
      <h1 class="mt-2 font-display text-3xl font-semibold tracking-tight text-ink">Live collaboration</h1>
      <div class="mt-4 flex flex-wrap gap-3 text-sm text-muted">
        <span class="inline-flex items-center gap-2"><%= avatar_chip_for(@booking.mentor_user) %> <%= @booking.mentor_user.display_name %></span>
        <span class="text-line">·</span>
        <span class="inline-flex items-center gap-2"><%= avatar_chip_for(@booking.learner) %> <%= @booking.learner.display_name %></span>
      </div>
      <p class="mt-3 text-sm text-muted"><%= l(@booking.starts_at, format: :long) %></p>
      <p class="mt-4"><%= booking_status_badge(@booking.status) %></p>
      <div class="mt-6 flex flex-wrap gap-2">
        <%= link_to "Open video", @booking.meet_url, target: "_blank", rel: "noopener", class: "btn-secondary" %>
        <%= link_to "ICS", ics_booking_path(@booking), class: "btn-secondary" %>
        <%= link_to "Booking", booking_path(@booking), class: "btn-secondary" %>
      </div>
      <p class="mt-6 text-xs text-muted">Firestore: <code class="text-ink/70"><%= @booking.firestore_room_id %></code></p>
    </section>

    <section class="surface p-5 sm:p-6">
      <h2 class="font-display text-xl font-semibold text-ink">Private notes</h2>
      <p class="mt-1 text-xs text-muted">Visible only to session participants in Rails.</p>
      <%= form_with url: booking_notes_path(@booking), scope: :booking_note, class: "mt-4 space-y-3" do |f| %>
        <%= f.text_area :body, rows: 3, class: "field", placeholder: "Prep notes, follow-ups…" %>
        <%= f.submit "Save note", class: "btn-ink cursor-pointer" %>
      <% end %>
      <% if @notes.any? %>
        <ul class="mt-4 space-y-3">
          <% @notes.each do |note| %>
            <li class="border-b border-line pb-3 text-sm">
              <div class="flex items-center gap-2">
                <%= avatar_chip_for(note.author) %>
                <p class="font-medium text-ink"><%= note.author.display_name %></p>
              </div>
              <p class="mt-2 text-muted whitespace-pre-line"><%= note.body %></p>
            </li>
          <% end %>
        </ul>
      <% else %>
        <p class="mt-4 text-sm text-muted">No notes yet.</p>
      <% end %>
    </section>
  </div>

  <section class="border border-line bg-room p-5 text-slate-100 sm:p-6"
           data-controller="session-chat"
           data-session-chat-user-value="<%= current_user.display_name %>"
           data-session-chat-config-value="<%= @firebase_config.to_json %>"
           data-session-chat-configured-value="<%= firebase_configured? %>"
           data-session-chat-room-value="<%= @room_payload.to_json %>">
    <div class="flex items-center justify-between gap-3">
      <h2 class="font-display text-xl font-semibold">Firestore chat</h2>
      <span data-session-chat-target="presence" class="text-xs text-teal-200/80">connecting…</span>
    </div>
    <p data-session-chat-target="typing" class="mt-1 min-h-4 text-xs text-teal-100/70"></p>

    <div data-session-chat-target="messages" class="mt-4 h-80 space-y-2 overflow-y-auto rounded-sm border border-white/10 bg-black/25 p-3 text-sm"></div>

    <form data-action="session-chat#send" class="mt-4 space-y-2">
      <input data-session-chat-target="input"
             data-action="input->session-chat#onType"
             type="text"
             placeholder="Write a message…"
             class="w-full rounded-sm border border-white/15 bg-white/10 px-3 py-2 text-sm text-white placeholder:text-white/45 focus:outline-none focus:ring-2 focus:ring-teal-400/40"
             autocomplete="off">
      <div class="flex flex-wrap items-center gap-2">
        <input data-session-chat-target="file" type="file" class="max-w-full text-xs text-teal-100/80">
        <button type="submit" class="rounded-sm bg-accent px-4 py-2 text-sm font-semibold text-white hover:bg-[var(--color-accent-hover)]">Send</button>
      </div>
    </form>
    <p data-session-chat-target="status" class="mt-2 text-xs text-rose-200"></p>
  </section>
</div>
