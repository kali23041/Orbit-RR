<!DOCTYPE html>
<html lang="en">
  <head>
    <title><%= content_for(:title) || "Orbit — Live skill sessions" %></title>
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <meta name="apple-mobile-web-app-capable" content="yes">
    <meta name="application-name" content="Orbit">
    <meta name="mobile-web-app-capable" content="yes">
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>

    <%= yield :head %>

    <link rel="icon" href="/icon.png" type="image/png">
    <link rel="icon" href="/icon.svg" type="image/svg+xml">
    <link rel="apple-touch-icon" href="/icon.png">

    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=DM+Sans:ital,opsz,wght@0,9..40,400;0,9..40,500;0,9..40,600;0,9..40,700;1,9..40,400&family=Syne:wght@500;600;700;800&display=swap" rel="stylesheet">

    <%= stylesheet_link_tag :app, "data-turbo-track": "reload" %>
    <%= javascript_importmap_tags %>
  </head>

  <body class="min-h-screen bg-canvas text-ink antialiased">
    <div class="pointer-events-none fixed inset-0 -z-10 orbit-atmosphere"></div>

    <header class="sticky top-0 z-40 border-b border-line/80 bg-canvas/85 backdrop-blur-md">
      <div class="mx-auto flex max-w-6xl items-center justify-between gap-4 px-5 py-4">
        <%= link_to root_path, class: "group flex items-baseline gap-2" do %>
          <span class="font-display text-2xl font-bold tracking-tight text-ink sm:text-[1.75rem]">Orbit</span>
        <% end %>

        <nav class="flex items-center gap-4 sm:gap-5">
          <%= link_to "Mentors", mentors_path, class: "nav-link" %>
          <% if signed_in? %>
            <%= link_to "Dashboard", dashboard_path, class: "nav-link" %>
            <%= link_to "Alerts", notifications_path, class: "nav-link hidden sm:inline" %>
            <% if current_user.admin? %>
              <%= link_to "Admin", admin_root_path, class: "nav-link hidden sm:inline" %>
            <% end %>
            <% if current_user.mentoring? %>
              <%= link_to "Mentor HQ", mentor_dashboard_path, class: "nav-link hidden sm:inline" %>
            <% else %>
              <%= link_to "Teach", new_mentor_profile_path, class: "nav-link hidden sm:inline" %>
            <% end %>
            <%= button_to "Sign out", session_path, method: :delete, class: "btn-ink" %>
          <% else %>
            <div data-controller="firebase-auth"
                 data-firebase-auth-configured-value="<%= firebase_configured? %>"
                 data-firebase-auth-config-value="<%= Rails.application.config.x.firebase.client_config.to_json %>">
              <button type="button"
                      data-action="firebase-auth#signIn"
                      class="btn-primary py-2">
                Sign in
              </button>
              <p data-firebase-auth-target="status" class="mt-1 max-w-40 text-xs text-rose-700"></p>
            </div>
          <% end %>
        </nav>
      </div>
    </header>

    <% if flash[:notice].present? || flash[:alert].present? %>
      <div class="mx-auto max-w-6xl px-5 pt-4">
        <% if flash[:notice].present? %>
          <p class="surface border-teal-200 bg-accent-soft px-3 py-2 text-sm text-accent"><%= flash[:notice] %></p>
        <% end %>
        <% if flash[:alert].present? %>
          <p class="surface border-rose-200 bg-rose-50 px-3 py-2 text-sm text-rose-800"><%= flash[:alert] %></p>
        <% end %>
      </div>
    <% end %>

    <main class="mx-auto max-w-6xl px-5 py-10 sm:py-12">
      <%= yield %>
    </main>

    <footer class="border-t border-line">
      <div class="mx-auto flex max-w-6xl flex-col gap-2 px-5 py-8 text-sm text-muted sm:flex-row sm:items-center sm:justify-between">
        <p class="font-display text-base font-semibold text-ink">Orbit</p>
        <p>Live skill sessions · Rails marketplace · Firebase realtime</p>
      </div>
    </footer>
  </body>
</html>
