<% content_for :title, "#{@mentor.user.display_name} — Orbit" %>

<div class="grid gap-10 lg:grid-cols-[1.1fr_0.9fr]">
  <section>
    <div class="flex flex-wrap items-start justify-between gap-3">
      <div class="flex items-start gap-4">
        <%= avatar_chip_for(@mentor.user, size_class: "avatar-chip h-14 w-14 text-base") %>
        <div>
          <p class="text-xs font-semibold uppercase tracking-[0.16em] text-accent">Mentor</p>
          <h1 class="mt-1 font-display text-4xl font-semibold tracking-tight text-ink sm:text-5xl"><%= @mentor.user.display_name %></h1>
        </div>
      </div>
      <% if signed_in? && current_user.id != @mentor.user_id %>
        <% if @favorited %>
          <%= button_to "Unfavorite", mentor_favorite_path(@mentor), method: :delete, class: "btn-secondary py-2" %>
        <% else %>
          <%= button_to "Favorite", mentor_favorite_path(@mentor), method: :post, class: "btn-secondary py-2" %>
        <% end %>
      <% end %>
    </div>
    <p class="mt-4 text-lg text-muted"><%= @mentor.headline %></p>
    <% if @mentor.average_rating %>
      <p class="mt-2 text-sm font-medium text-ink">★ <%= @mentor.average_rating %> · <%= @mentor.reviews_count %> reviews</p>
    <% end %>
    <p class="mt-6 whitespace-pre-line leading-relaxed text-ink/80"><%= @mentor.bio %></p>
    <div class="mt-6 flex flex-wrap gap-2">
      <% @mentor.skills.each do |skill| %>
        <span class="chip"><%= skill.name %></span>
      <% end %>
    </div>
    <p class="mt-8 font-display text-3xl font-semibold text-accent">
      <%= format_money(@mentor.hourly_rate_cents, @mentor.currency) %>
      <span class="text-base font-normal text-muted">/ session</span>
    </p>
  </section>

  <section class="surface p-5 sm:p-6 lg:sticky lg:top-24 lg:self-start">
    <h2 class="font-display text-2xl font-semibold text-ink">Open slots</h2>
    <% if @slots.any? %>
      <ul class="mt-4 space-y-3">
        <% @slots.each do |slot| %>
          <li class="flex flex-col gap-3 border border-line bg-canvas/70 p-3 sm:flex-row sm:items-center sm:justify-between">
            <div>
              <p class="font-medium text-ink"><%= l(slot.starts_at, format: :long) %></p>
              <p class="text-sm text-muted"><%= slot.duration_minutes %> minutes</p>
            </div>
            <% if signed_in? %>
              <%= button_to "Book", bookings_path(availability_slot_id: slot.id), method: :post, class: "btn-primary py-2" %>
            <% else %>
              <p class="text-sm text-muted">Sign in to book</p>
            <% end %>
          </li>
        <% end %>
      </ul>
    <% else %>
      <div class="empty-state mt-4 py-8">
        <p class="text-sm text-muted">No open slots right now.</p>
      </div>
    <% end %>
  </section>
</div>

<% if @reviews.any? %>
  <section class="mt-14 border-t border-line pt-10">
    <h2 class="page-title">Reviews</h2>
    <ul class="mt-4 space-y-3">
      <% @reviews.each do |review| %>
        <li class="border-b border-line py-4">
          <div class="flex items-center gap-2">
            <%= avatar_chip_for(review.reviewer) %>
            <p class="font-medium text-ink"><%= review.rating %>/5 · <%= review.reviewer.display_name %></p>
          </div>
          <p class="mt-2 text-sm text-muted"><%= review.body %></p>
        </li>
      <% end %>
    </ul>
  </section>
<% end %>
