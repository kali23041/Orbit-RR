<% content_for :title, "Mentors — Orbit" %>

<div class="mb-8 flex flex-col gap-4 sm:flex-row sm:items-end sm:justify-between">
  <div>
    <h1 class="text-4xl text-slate-950" style="font-family: Fraunces, serif;">Mentors</h1>
    <p class="mt-2 text-slate-600">Filter by skill and book an open slot.</p>
  </div>
  <div class="flex flex-wrap gap-2">
    <%= link_to "All", mentors_path, class: "rounded-sm px-3 py-1.5 text-sm #{params[:skill].blank? ? 'bg-slate-900 text-white' : 'border border-slate-900/15 bg-white'}" %>
    <% @skills.each do |skill| %>
      <%= link_to skill.name, mentors_path(skill: skill.slug), class: "rounded-sm px-3 py-1.5 text-sm #{params[:skill] == skill.slug ? 'bg-slate-900 text-white' : 'border border-slate-900/15 bg-white'}" %>
    <% end %>
  </div>
</div>

<div class="grid gap-4 sm:grid-cols-2 lg:grid-cols-3">
  <% @mentors.each do |mentor| %>
    <article class="border border-slate-900/10 bg-white/70 p-5">
      <h2 class="text-xl font-semibold"><%= mentor.user.display_name %></h2>
      <p class="mt-1 text-sm text-slate-600"><%= mentor.headline %></p>
      <p class="mt-3 text-xs uppercase tracking-wide text-slate-500"><%= mentor.skills.map(&:name).join(" · ") %></p>
      <div class="mt-5 flex items-center justify-between">
        <span class="font-medium text-[#1f6b4a]"><%= format_money(mentor.hourly_rate_cents, mentor.currency) %></span>
        <%= link_to "View profile", mentor_path(mentor), class: "text-sm font-semibold text-slate-900 underline" %>
      </div>
    </article>
  <% end %>
</div>
