rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function isRoomMember(roomId) {
      return signedIn() && (
        request.auth.uid == get(/databases/$(database)/documents/rooms/$(roomId)).data.learnerUid ||
        request.auth.uid == get(/databases/$(database)/documents/rooms/$(roomId)).data.mentorUid
      );
    }

    function isCreatingRoomAsMember() {
      return signedIn() && (
        request.auth.uid == request.resource.data.learnerUid ||
        request.auth.uid == request.resource.data.mentorUid
      );
    }

    match /user_public/{uid} {
      allow read: if signedIn();
      allow write: if signedIn() && request.auth.uid == uid;
    }

    match /rooms/{roomId} {
      allow read: if isRoomMember(roomId) || isCreatingRoomAsMember();
      allow create: if isCreatingRoomAsMember()
        && request.resource.data.keys().hasAll(['learnerUid', 'mentorUid', 'railsBookingId']);
      allow update: if isRoomMember(roomId);

      match /messages/{messageId} {
        allow read: if isRoomMember(roomId);
        allow create: if isRoomMember(roomId)
          && request.resource.data.senderUid == request.auth.uid
          && request.resource.data.keys().hasAny(['text', 'type']);
        allow update, delete: if false;
      }

      match /presence/{uid} {
        allow read: if isRoomMember(roomId);
        allow write: if isRoomMember(roomId) && request.auth.uid == uid;
      }

      match /typing/{uid} {
        allow read: if isRoomMember(roomId);
        allow write: if isRoomMember(roomId) && request.auth.uid == uid;
      }
    }
  }
}
